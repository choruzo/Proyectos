# =============================================================================
# Web UI (Flask + Gunicorn) para Podman
# =============================================================================
# Build (contexto = cicd/):
#   podman build --platform linux/amd64 \
#     -f podman/Containerfile.web -t localhost/cicd-web:local .
# =============================================================================

ARG BASE_IMAGE=opensuse/leap:15.5
FROM ${BASE_IMAGE}

ARG AGENT_UID=1000
ARG AGENT_GID=1000

RUN zypper -n refresh && \
    zypper -n install --no-recommends \
        bash coreutils python3 python3-pip ca-certificates curl && \
    zypper -n clean -a

RUN groupadd -g "${AGENT_GID}" agent 2>/dev/null || true && \
    useradd -m -u "${AGENT_UID}" -g "${AGENT_GID}" -s /bin/bash agent 2>/dev/null || true

COPY . /home/agent/cicd

# Dependencias Python desde las ruedas offline del repositorio.
RUN find /home/agent/cicd -type f \( -name '*.sh' -o -name '*.py' \) \
        -exec sed -i 's/\r$//' {} + && \
    find /home/agent/cicd -type d -name __pycache__ -prune -exec rm -rf {} + && \
    pip3 install --no-index --find-links=/home/agent/cicd/python/packages \
        -r /home/agent/cicd/python/packages/requirements.txt && \
    mkdir -p /home/agent/cicd/logs /home/agent/cicd/db && \
    chown -R "${AGENT_UID}:${AGENT_GID}" /home/agent

USER ${AGENT_UID}:${AGENT_GID}

ENV HOME=/home/agent \
    CICD_HOME=/home/agent/cicd \
    PATH=/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8 \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=8080 \
    WEB_DEBUG=false

WORKDIR /home/agent/cicd/web

ENTRYPOINT ["python3", "-m", "gunicorn"]
CMD ["--bind", "0.0.0.0:8080", \
     "--workers", "2", \
     "--threads", "2", \
     "--timeout", "120", \
     "--access-logfile", "/home/agent/cicd/logs/web_access.log", \
     "--error-logfile", "/home/agent/cicd/logs/web_error.log", \
     "--log-level", "info", \
     "app:app"]
