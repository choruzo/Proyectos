# =============================================================================
# Variables para run.sh (exportar o editar antes de arrancar)
# =============================================================================
# Copia a env.local y: set -a; source env.local; set +a

# Directorio de la app en el host (config, db, logs)
CICD_DIR=/home/agent/cicd

# Clon del repositorio GALTTCMC (git.repo_local_path)
REPO_DIR=/home/agent/GALTTCMC

# Directorio de compilacion compartido (git.compile_path)
COMPILE_PATH=/home/agent/V08.XX.XX.XX

# Claves SSH del host (montadas en solo lectura en el contenedor)
SSH_DIR=/home/agent/.ssh

# Script de /etc/profile.d que actualiza notify.sh
PROFILE_SCRIPT=/etc/profile.d/informacion.sh

# Runner de compilacion en el host
CICD_HOST_DIR=/home/agent/cicd-host

# Usuario con el que se hace SSH local (por defecto, el usuario actual)
# HOST_USER=agent

# Bundle de CA del host montado en el contenedor (git/curl/Sonar/vCenter)
# CA_BUNDLE=/etc/ssl/ca-bundle.pem
